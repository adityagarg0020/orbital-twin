# ==============================================================
# ORBITAL TWIN - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================

# Application
APP_NAME="ORBITAL TWIN"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Database Configuration (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./orbital_twin.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/orbital_twin"

# NASA SMAP/MSL Benchmark Dataset Location
NASA_DATA_PATH="spacecraft-digital-twin-data/01_nasa_smap_msl"

# Grok AI Mission Assistant API Configuration (xAI API / OpenAI Compatible)
# Leave blank to use high-fidelity deterministic aerospace expert fallback
GROK_API_KEY=
GROK_MODEL="grok-beta"
GROK_BASE_URL="https://api.x.ai/v1"

# Simulation tick interval in seconds (default: 1.0s = 1Hz)
SIMULATION_TICK_SECONDS=1.0
